{
  "swagger": "2.0",
  "info": {
    "title": "Organize API",
    "description": "Api de reconhecimento facial",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/clientes/": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "description": "Retorna lista de clientes",
        "responses": {
          "200": {
            "description": "Retorna lista de clientes",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "number",
                    "example": 1
                  },
                  "nome": {
                    "type": "string",
                    "example": "nome"
                  },
                  "email": {
                    "type": "string",
                    "example": "email@email.com"
                  },
                  "foto": {
                    "type": "string",
                    "example": "url da imagem"
                  },
                  "facial": {
                    "type": "string",
                    "example": "json da facial"
                  },
                  "created_at": {
                    "type": "string",
                    "example": "data"
                  },
                  "updated_at": {
                    "type": "string",
                    "example": "data"
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "422": {
            "description": "Erro interno",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "error"
                },
                "description": {
                  "type": "string",
                  "example": "mensagem do sistema"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      },
      "post": {
        "description": "Cria um registro",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "nome",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": "Nome do cliente",
            "example": "nome"
          },
          {
            "name": "email",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": "E-mail do cliente",
            "example": "email@email.com"
          },
          {
            "name": "foto",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": "Arquivo de imagem"
          }
        ],
        "responses": {
          "200": {
            "description": "Registro criado com sucesso",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "success"
                },
                "description": {
                  "type": "string",
                  "example": "Registro criado com sucesso."
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "422": {
            "description": "Erro interno",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "error"
                },
                "description": {
                  "type": "string",
                  "example": "mensagem do sistema"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/clientes/{id}": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "description": "Retorna um cliente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Retorna um cliente",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "number",
                  "example": 1
                },
                "nome": {
                  "type": "string",
                  "example": "nome"
                },
                "email": {
                  "type": "string",
                  "example": "email@email.com"
                },
                "foto": {
                  "type": "string",
                  "example": "url da imagem"
                },
                "facial": {
                  "type": "string",
                  "example": "json da facial"
                },
                "created_at": {
                  "type": "string",
                  "example": "data"
                },
                "updated_at": {
                  "type": "string",
                  "example": "data"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "422": {
            "description": "Erro interno",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "error"
                },
                "description": {
                  "type": "string",
                  "example": "mensagem do sistema"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Clientes"
        ],
        "description": "Deleta um cliente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleta um cliente",
            "type": "success"
          },
          "422": {
            "description": "Erro interno",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "error"
                },
                "description": {
                  "type": "string",
                  "example": "mensagem do sistema"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/clientes/reconhecimento": {
      "post": {
        "description": "Reconheci um rosto na imagem",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "foto",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": "Arquivo de imagem para reconhecimento"
          }
        ],
        "responses": {
          "200": {
            "description": "Registro criado com sucesso",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "success"
                },
                "cliente": {
                  "type": "object",
                  "properties": {
                    "nome": {
                      "type": "string",
                      "example": "nome"
                    },
                    "email": {
                      "type": "string",
                      "example": "email@email.com"
                    },
                    "foto": {
                      "type": "string",
                      "example": "https://host/uploads/facial/imagem.jpg"
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "422": {
            "description": "Erro interno",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "error"
                },
                "description": {
                  "type": "string",
                  "example": "mensagem do sistema"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    }
  }
}